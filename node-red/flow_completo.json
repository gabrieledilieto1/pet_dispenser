    {
        "id": "40d89f2e604a41bb",
        "type": "function",
        "z": "386502f2d02e1649",
        "name": "Salva log erogazione",
        "func": "\nconst animal_id = msg.topic.split(\"/\")[1];\nconst payload = JSON.parse(msg.payload);\nmsg.params = [animal_id, payload.grams];\nmsg.query = \"INSERT INTO dispenser_logs (animal_id, grams) VALUES ($1, $2)\";\nreturn msg;\n",

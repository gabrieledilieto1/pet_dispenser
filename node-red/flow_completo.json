    {
        "id": "proximity-check",
        "type": "function",
        "z": "386502f2d02e1649",
        "name": "Verifica orario prossimo",
        "func": "let now = new Date();\nlet schedTime = new Date(msg.payload.scheduled);\nlet diff = (schedTime - now) / 60000;\nif (diff <= 10 && diff > 0) {\n    return { payload: { action: \"dispense\", quantity: 50 } };\n} else {\n    return null;\n}",
        "outputs": 1,
        "noerr": 0,
        "x": 410,
        "y": 540,

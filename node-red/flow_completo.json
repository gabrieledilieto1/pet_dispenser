        "name": "Salva log prossimità",
        "func": "\nconst animal_id = msg.topic.split(\"/\")[1];\nconst payload = JSON.parse(msg.payload);\nmsg.params = [animal_id, payload.detected];\nmsg.query = \"INSERT INTO proximity_log (animal_id, detected) VALUES ($1, $2)\";\nreturn msg;\n",

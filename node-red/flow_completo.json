    {
        "id": "bd62bb82517199f9",
        "type": "postgresql",
        "z": "386502f2d02e1649",
        "name": "Leggi orari dal DB",
        "query": "SELECT schedule_time, portion_grams, proximity_enabled, manual_mode FROM dispenser_schedules WHERE animal_id = $1 AND active = true ORDER BY schedule_time",
        "postgreSQLConfig": "7ed30b6f68fe75b1",
        "split": false,
        "rowsPerMsg": "",
        "outputs": 1,
        "x": 500,
        "y": 60,
        "wires": [
            [
                "5e46be0a9ae6ea89"
            ]
        ]
    },
    {
        "id": "5e46be0a9ae6ea89",
        "type": "function",
        "z": "386502f2d02e1649",
        "name": "Formatta JSON MQTT",
        "func": "\nconst id = flow.get('animal_id');\nmsg.topic = `dispenser/${id}/settings`;\nmsg.payload = msg.payload.map(row => ({\n    time: row.schedule_time,\n    grams: row.portion_grams,\n    proximity: row.proximity_enabled,\n    manual: row.manual_mode\n}));\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 60,
        "wires": [
            [
                "5a9fc03781bffb74"
            ]
        ]
    },

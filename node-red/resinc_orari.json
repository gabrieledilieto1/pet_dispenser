    },
    {
        "id": "c3189d4dab07af41",
        "type": "function",
        "z": "08dddd1bc95b3ea9",
        "name": "Formatta settings per MQTT",
        "func": "\nconst id = flow.get('animal_id');\nmsg.topic = `dispenser/${id}/settings`;\nmsg.payload = msg.payload.map(e => ({\n    time: e.schedule_time,\n    grams: e.portion_grams,\n    proximity: e.proximity_enabled,\n    manual: e.manual_mode\n}));\nreturn msg;\n",
        "outputs": 1,

ize":"","libs":[],"x":370,"y":260,"wires":[["935e0999fbeb25c7"]]},{"id":"935e0999fbeb25c7","type":"postgresql","z":"386502f2d02e1649","name":"db log prossimità","query":"INSERT INTO proximity_log (animal_id, detected, timestamp) VALUES ($1, $2, NOW());\n","postgreSQLConfig":"6cb232d1ea4cf77d","split":false,"rowsPerMsg":"","outputs":1,"x":590,"y":260,"wires":[[]]},{"id":"mqtt-auto-feed","type":"mqtt in","z":"386502f2d02e1649","name":"Auto Feed Trigger","topic":"/petfeeder/schedule","qos":"2","datatype":"auto-detect","broker":"7d5bdd1b4421a6a3","nl":false,"rap":false,"inputs":0,"x":150,"y":360,"wires":[["feed-command"]]},{"id":"feed-command","type":"function","z":"386502f2d02e1649","name":"Comando Erogazione","func":"msg.payload = {\n    action: \"dispense\",\n    quantity: 50\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":360,"y":360,"wires":[["mqtt-out-dispenser"]]},{"id":"mqtt-out-dispenser","type":"mqtt out","z":"386502f2d02e1649","name":"Invia comando a ESP32","topic":"/petfeeder/dispenser/cmd","qos":"0","retain":"false","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"7d5bdd1b4421a6a3","x":610,"y":360,"wires":[]},{"id":"proximity-sensor","type":"mqtt in","z":"386502f2d02e1649","name":"Prossimità","topic":"/petfeeder/sensor/proximity","qos":"2","datatype":"auto-detect","broker":"7d5bdd1b4421a6a3","nl":false,"rap":false,"inputs":0,"x":120,"y":420,"wires":[["proximity-check"]]},{"id":"proximity-check","type":"function","z":"386502f2d02e1649","name":"Verifica orario prossimo","func":"let now = new Date();\nlet schedTime = new Date(msg.payload.scheduled);\nlet diff = (schedTime - now) / 60000;\nif (diff <= 10 && diff > 0) {\n    return { payload: { action: \"dispense\", quantity: 50 } };\n} else {\n    return null;\n}","outputs":1,"timeout":"","noerr":2,"initialize":"","finalize":"","libs":[],"x":380,"y":420,"wires":[["mqtt-out-dispenser"]]},{"id":"f7b826dc58a2add9","type":"mqtt in","z"
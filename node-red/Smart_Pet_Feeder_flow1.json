    {
        "id": "baa23eaff87bfcb2",
        "type": "function",
        "z": "ccb948fc121152fe",
        "name": "Salva log allarme",
        "func": "const animal_id = 1; \nlet alarm_type = 'Accumolo rilevato';  \nlet handled = true;  \n\nif (typeof msg.payload === 'object' && msg.payload !== null) {\n    alarm_type = msg.payload.alarm_type || alarm_type;  // utilizza il tipo di allarme dal payload\n    handled = msg.payload.handled || handled;  // utilizza il flag \"handled\" dal payload\n} else if (typeof msg.payload === 'string') {\n    alarm_type = msg.payload.toLowerCase().includes('Accumolo rilevato') ? 'Accumolo rilevato' : 'altro';\n}\n\nmsg.params = [animal_id, alarm_type, handled];\nmsg.query = \"INSERT INTO alarm_log (animal_id, alarm_type, timestamp, handled, notes) VALUES ($1, $2, NOW(), $3, $4)\";\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 300,

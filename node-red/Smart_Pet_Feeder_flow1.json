    {
        "id": "4f4bcc2a7adbd946",
        "type": "function",
        "z": "ccb948fc121152fe",
        "name": "Salva log prossimità",
        "func": "const animal_id = 1;  // metti qui l'ID corretto dell'animale\nlet detected = true;\n\nif (typeof msg.payload === 'object' && msg.payload !== null) {\n    detected = msg.payload.detected === true;\n} else if (typeof msg.payload === 'string') {\n    detected = msg.payload.toLowerCase().includes('erogazione completata');\n}\n\nmsg.params = [animal_id, detected];\nmsg.query = \"INSERT INTO proximity_log (animal_id, detected, timestamp) VALUES ($1, $2, NOW())\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,

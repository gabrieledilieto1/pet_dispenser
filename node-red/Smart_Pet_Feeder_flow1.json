    {
        "id": "150d2e66c0c71609",
        "type": "postgresql",
        "z": "ccb948fc121152fe",
        "name": "Leggi orari dal DB",
        "query": "SELECT schedule_time, portion_grams, proximity_enabled, a.name FROM dispenser_schedules\nJOIN animals a ON a.id = dispenser_schedules.animal_id\n WHERE animal_id = 1 AND active = true ORDER BY schedule_time",
        "postgreSQLConfig": "7ed30b6f68fe75b1",
        "split": false,
        "rowsPerMsg": "",
        "outputs": 1,
        "x": 500,
        "y": 60,
        "wires": [
            [
                "b8c06829071f1be1"
            ]
        ]
    },
    {
        "id": "b8c06829071f1be1",
        "type": "function",
        "z": "ccb948fc121152fe",
        "name": "Formatta JSON MQTT",
        "func": "// msg.payload contiene un array di righe dal DB\n// Lo trasformiamo in JSON che l'ESP32 può interpretare\n\nlet schedules = msg.payload.map(item => ({\n    time: item.schedule_time,\n    grams: item.portion_grams,\n    proximityEnabled: item.proximity_enabled\n}));\n\nmsg.payload = JSON.stringify(schedules);\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 60,
        "wires": [
